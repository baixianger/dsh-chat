{
  "name": "dsh-chat",
  "version": "0.1.0-rc.2",
  "description": "Web group chat for local and woven DeepSeek Harness sessions.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["lib/", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/room-store.js && npm pack --dry-run",
    "test": "node --test test/**/*.test.mjs"
  },
  "keywords": ["deepseek-harness", "dsh", "chat", "agent", "conversation", "mesh"],
  "author": "Xiang Bai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baixianger/dsh-chat.git"
  },
  "homepage": "https://github.com/baixianger/dsh-chat#readme",
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "tag": "next" }
}
